---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
// TODO: fill in real GbR details once registered.
---
<Base title="Impressum">
<div class="wrap page prose">
<h1><T en="Imprint / Legal Information (Impressum)" de="Impressum" /></h1>
<p><T en="Information according to § 5 DDG (formerly TMG)" de="Angaben gemäß § 5 DDG (ehemals TMG)" /></p>
<h2 style="font-size:1.2rem"><T en="Company" de="Unternehmen" /></h2><p class="ph">[Placeholder: e.g., Max Müller &amp; Anna Schmidt GbR]</p>
<h2 style="font-size:1.2rem"><T en="Address" de="Anschrift" /></h2><p class="ph">[Placeholder Street, Placeholder Zip Code Placeholder City, Germany]</p>
<h2 style="font-size:1.2rem"><T en="Represented by (Managing Partners)" de="Vertreten durch (geschäftsführende Gesellschafter)" /></h2><p class="ph">[Placeholder Partner 1], [Placeholder Partner 2]</p>
<h2 style="font-size:1.2rem"><T en="Contact" de="Kontakt" /></h2><p class="ph"><T en="E-Mail" de="E-Mail" />: [Placeholder Contact E-Mail]<br /><T en="Phone" de="Telefon" />: [Placeholder Contact Number]</p>
<h2 style="font-size:1.2rem"><T en="Legal Registration" de="Registereintrag" /></h2><p class="ph">[Placeholder: e.g., Registered with Gewerbeamt Wolfsburg / optional eGbR Gesellschaftsregister number]</p>
<h2 style="font-size:1.2rem"><T en="VAT ID (Umsatzsteuer-ID)" de="Umsatzsteuer-Identifikationsnummer" /></h2><p class="ph">[Placeholder VAT ID from Finanzamt]</p>
</div>
</Base>
